# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_data_analyst
DATA_STORAGE_DIR=./data/uploads
MAX_UPLOAD_BYTES=26214400
MAX_DAILY_ANALYSES=100
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=
